    <artifactId>agentflow-event-service</artifactId>
    <name>AgentFlow Event Service</name>
    <dependencies>
        <dependency>
            <groupId>io.github.pravinkaveya473sketch</groupId>
            <artifactId>agentflow-event-contract</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-kafka</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-jackson2</artifactId></dependency>
