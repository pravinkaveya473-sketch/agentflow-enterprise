# AI provider
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# Database / Redis / Kafka
MYSQL_URL=jdbc:mysql://localhost:3306/agentflow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
EVENT_MYSQL_URL=jdbc:mysql://localhost:3306/agentflow_event?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=agent
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TASK_EVENT_TOPIC=agentflow.task.lifecycle.v1
OUTBOX_PUBLISH_INTERVAL=1s

# Security: generate a random value of at least 32 bytes; do not commit the real value
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=agentflow-enterprise
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Observability
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
